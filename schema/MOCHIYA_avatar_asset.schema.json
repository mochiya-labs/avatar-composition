{
  "$ref": "#/definitions/MOCHIYA_avatar_asset",
  "definitions": {
    "MOCHIYA_avatar_asset": {
      "type": "object",
      "properties": {
        "specVersion": {
          "type": "string",
          "const": "0.1"
        },
        "assetKind": {
          "type": "string",
          "enum": [
            "avatar",
            "attachment"
          ],
          "description": "An independent avatar or an attachment that depends on a base avatar."
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 32,
          "default": []
        },
        "matching": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "keywordBestEffort"
            },
            "armatureKeywords": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 32,
              "default": []
            },
            "onUnresolved": {
              "type": "string",
              "const": "warnAndContinue"
            }
          },
          "required": [
            "mode",
            "onUnresolved"
          ],
          "additionalProperties": false
        },
        "rig": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "avatar",
                "attachmentReference"
              ],
              "description": "Avatar rig or attachment reference rig; a reference humanoid does not make an attachment a base avatar."
            },
            "jointMappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceNode": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "asset": {
                        "type": "string",
                        "enum": [
                          "self",
                          "base"
                        ]
                      },
                      "node": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
                      },
                      "boneKeywords": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords"
                      },
                      "meshKeywords": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords"
                      },
                      "nodeKeywords": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords"
                      },
                      "blendshapeKeywords": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords"
                      },
                      "morphIndex": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
                      },
                      "humanBone": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "parentKeywords": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords"
                      }
                    },
                    "required": [
                      "asset"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "sourceNode",
                  "target"
                ],
                "additionalProperties": false
              },
              "maxItems": 4096,
              "default": []
            },
            "attachmentRoots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceNode": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
                  },
                  "target": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "preserveWorld",
                      "snap"
                    ],
                    "default": "preserveWorld"
                  }
                },
                "required": [
                  "sourceNode",
                  "target"
                ],
                "additionalProperties": false
              },
              "maxItems": 4096,
              "default": []
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 256
              },
              "defaultValue": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "min": {
                "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0"
              },
              "max": {
                "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0"
              }
            },
            "required": [
              "id",
              "label",
              "defaultValue"
            ],
            "additionalProperties": false
          },
          "maxItems": 1024,
          "default": []
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
              },
              "aliases": {
                "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords",
                "default": []
              },
              "active": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "node"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000,
          "default": []
        },
        "actions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "condition": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "nodeActive",
                          "control"
                        ]
                      },
                      "asset": {
                        "type": "string",
                        "enum": [
                          "self",
                          "base"
                        ]
                      },
                      "node": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
                      },
                      "nodeKeywords": {
                        "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/matching/properties/armatureKeywords"
                      },
                      "control": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "value": {
                        "anyOf": [
                          {
                            "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "inverse": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "sourceOrder": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0",
                    "default": 0
                  },
                  "type": {
                    "type": "string",
                    "const": "morph.sync"
                  },
                  "driver": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "driven": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "curve": {
                    "type": "object",
                    "properties": {
                      "interpolation": {
                        "type": "string",
                        "enum": [
                          "linear",
                          "step"
                        ]
                      },
                      "points": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": [
                            {
                              "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0"
                            },
                            {
                              "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0"
                            }
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 4096
                      }
                    },
                    "required": [
                      "interpolation",
                      "points"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "type",
                  "driver",
                  "driven"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/id"
                  },
                  "condition": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/condition"
                  },
                  "sourceOrder": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/sourceOrder"
                  },
                  "type": {
                    "type": "string",
                    "const": "morph.override"
                  },
                  "target": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "value": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/controls/items/properties/defaultValue/anyOf/0"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "target",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/id"
                  },
                  "condition": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/condition"
                  },
                  "sourceOrder": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/sourceOrder"
                  },
                  "type": {
                    "type": "string",
                    "const": "node.active"
                  },
                  "target": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "target",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/id"
                  },
                  "condition": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/condition"
                  },
                  "sourceOrder": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/sourceOrder"
                  },
                  "type": {
                    "type": "string",
                    "const": "material.swap"
                  },
                  "target": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "slot": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
                  },
                  "material": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/sourceNode"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "target",
                  "slot",
                  "material"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/id"
                  },
                  "condition": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/condition"
                  },
                  "sourceOrder": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/actions/items/anyOf/0/properties/sourceOrder"
                  },
                  "type": {
                    "type": "string",
                    "const": "collider.link"
                  },
                  "target": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  },
                  "collider": {
                    "$ref": "#/definitions/MOCHIYA_avatar_asset/properties/rig/properties/jointMappings/items/properties/target"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "target",
                  "collider"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 10000,
          "default": []
        }
      },
      "required": [
        "specVersion",
        "assetKind"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
