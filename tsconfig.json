{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"declaration": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
